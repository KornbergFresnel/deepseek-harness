{
  "name": "@deepseek-ai/dsh-experimental-sco",
  "description": "SenseCore SSP training-job operations through the local sco CLI",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
